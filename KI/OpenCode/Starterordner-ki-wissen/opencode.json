{
  "$schema": "https://opencode.ai/config.json",
  "model": "hsd/openai-gpt-oss-120b",
  "small_model": "hsd/openai-gpt-oss-120b",
  "enabled_providers": ["hsd"],
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": "deny",
    "webfetch": "deny",
    "execute": "deny",
    "edit": "allow",
    "external_directory": "deny"
  },
  "provider": {
    "hsd": {
      "name": "KI:connect",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://chat.kiconnect.nrw/api/v1" },
      "models": {
        "openai-gpt-oss-120b": { "name": "GPT-OSS 120B", "tool_call": true }
      }
    }
  }
}
